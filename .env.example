# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Storage
DOWNLOAD_DIR=./downloads
DATABASE_PATH=./ytdl.db

# Concurrency & Limits
MAX_CONCURRENT_DOWNLOADS=3
MAX_BATCH_SIZE=20
MAX_PLAYLIST_ITEMS=50
MAX_QUEUE_DEPTH=50
DOWNLOAD_TIMEOUT=1800

# File Retention
FILE_RETENTION_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Request Size (bytes) - 1MB default
MAX_CONTENT_LENGTH=1048576

# Retry
MAX_RETRIES=3

# FFmpeg (leave empty to use system PATH)
FFMPEG_PATH=

# YouTube Bot-Detection Bypass (Cookie Strategy)
# The app automatically tries to use cookies from your installed browser so
# downloads work without any extra setup. Options:
#
# YTDL_COOKIES_BROWSER — Force a specific browser (chrome, firefox, edge,
#   brave, safari, chromium). Set to "none" to disable auto-detection.
#   Leave empty to auto-detect (tries Chrome → Firefox → Edge → Brave).
YTDL_COOKIES_BROWSER=
#
# YTDL_COOKIES_PATH — Absolute path to a Netscape-format cookies.txt file.
#   If set, this takes priority over browser auto-detection.
YTDL_COOKIES_PATH=
#
# YTDL_COOKIES_TEXT — Raw cookie content (Netscape format). Written to a temp
#   file automatically. Takes priority over browser auto-detection.
YTDL_COOKIES_TEXT=
